generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model user {
  user_id       String    @id @default(uuid()) @db.Uuid
  username      String    @unique
  email         String    @unique
  password_hash String?
  full_name     String
  phone         String?
  age           Int?
  gender        String?
  height        Float?
  weight        Float?
  bmi           Decimal   @default(0) @db.Decimal(10, 2)
  birthday      DateTime?
  is_active     Boolean   @default(true)
  created_at    DateTime  @default(now()) @db.Timestamptz(6)
  updated_at    DateTime  @updatedAt @db.Timestamptz(6)

  budget_daily   Decimal @default(0) @db.Decimal(10, 2)
  budget_weekly  Decimal @default(0) @db.Decimal(10, 2)
  budget_monthly Decimal @default(0) @db.Decimal(10, 2)

  calories_per_day      Int                  @default(0)
  daily_target_calories Int                  @default(0)
  activity_level        users_activity_level
  liked_foods           Json?
  preferred_food_types  Json?
  health_goals_list     Json?
  google_id             String?              @unique
  is_email_verified     Boolean              @default(false)

  email_verification_tokens emailVerificationToken[]
  forget_password_tokens    forgetPasswordToken[]
  meal_plans                mealPlan[]
}

model forgetPasswordToken {
  id         String    @id @default(uuid()) @db.Uuid
  token_hash String    @unique
  user_id    String    @db.Uuid
  expires_at DateTime
  used_at    DateTime?
  created_at DateTime  @default(now()) @db.Timestamptz(6)

  user user @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@index([user_id])
}

model emailVerificationToken {
  id         String    @id @default(uuid()) @db.Uuid
  token_hash String    @unique
  user_id    String    @db.Uuid
  expires_at DateTime
  used_at    DateTime?
  created_at DateTime  @default(now()) @db.Timestamptz(6)

  user user @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@index([user_id])
}

enum users_activity_level {
  SEDENTARY
  LIGHT_1_3
  MODERATE_3_5
  ACTIVE_6_7
  VERY_ACTIVE
}

model recipe {
  recipe_id      String   @id @default(uuid()) @db.Uuid
  name           String
  description    String?
  meal_type      String
  calories       Int
  protein_g      Decimal  @db.Decimal(10, 2)
  carbs_g        Decimal  @db.Decimal(10, 2)
  fat_g          Decimal  @db.Decimal(10, 2)
  estimated_cost Decimal  @db.Decimal(10, 2)
  emoji          String?
  is_active      Boolean  @default(true)
  created_at     DateTime @default(now()) @db.Timestamptz(6)
  updated_at     DateTime @updatedAt @db.Timestamptz(6)

  meal_plan_items mealPlanItem[]

  @@index([meal_type])
  @@index([is_active])
}

model mealPlan {
  meal_plan_id   String   @id @default(uuid()) @db.Uuid
  user_id        String   @db.Uuid
  plan_date      DateTime @db.Date
  total_calories Int      @default(0)
  total_cost     Decimal  @default(0) @db.Decimal(10, 2)
  created_at     DateTime @default(now()) @db.Timestamptz(6)
  updated_at     DateTime @updatedAt @db.Timestamptz(6)

  user            user           @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  meal_plan_items mealPlanItem[]

  @@unique([user_id, plan_date])
  @@index([plan_date])
}

model mealPlanItem {
  meal_plan_item_id String   @id @default(uuid()) @db.Uuid
  meal_plan_id      String   @db.Uuid
  recipe_id         String   @db.Uuid
  meal_type         String
  servings          Decimal  @default(1) @db.Decimal(5, 2)
  calories_snapshot Int
  cost_snapshot     Decimal  @db.Decimal(10, 2)
  sort_order        Int      @default(0)
  created_at        DateTime @default(now()) @db.Timestamptz(6)
  updated_at        DateTime @updatedAt @db.Timestamptz(6)

  meal_plan mealPlan @relation(fields: [meal_plan_id], references: [meal_plan_id], onDelete: Cascade)
  recipe    recipe   @relation(fields: [recipe_id], references: [recipe_id], onDelete: Restrict)

  @@unique([meal_plan_id, meal_type])
  @@index([recipe_id])
}

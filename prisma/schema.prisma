generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model user {
  user_id       String  @id @default(uuid())
  username     String  @unique
  email         String  @unique
  password_hash String?
  full_name     String
  phone         String? 
  age           Int?
  gender        String?
  height        Float?
  weight        Float?
  bmi           Decimal @default(0) @db.Decimal(10,2)
  birthday      DateTime?
  is_active     Boolean @default(true)
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  updated_at    DateTime @updatedAt @db.Timestamptz(6)

  budget_daily   Decimal @default(0) @db.Decimal(10,2)
  budget_weekly Decimal @default(0) @db.Decimal(10,2)
  budget_monthly Decimal @default(0) @db.Decimal(10,2)

  calories_per_day    Int @default(0)
  daily_target_calories Int @default(0)
  activity_level     users_activity_level
  liked_foods        Json?
  preferred_food_types Json?
  health_goals_list Json?
  google_id String? @unique
  is_email_verified Boolean @default(false)
}



enum users_activity_level {
  SEDENTARY    
  LIGHT_1_3    
  MODERATE_3_5 
  ACTIVE_6_7   
  VERY_ACTIVE  
}